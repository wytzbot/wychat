rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function room(roomId) { return get(/databases/$(database)/documents/rooms/$(roomId)); }
    function roomExists(roomId) { return exists(/databases/$(database)/documents/rooms/$(roomId)); }

    function isRoomOwner(roomId) {
      return signedIn() && roomExists(roomId)
        && room(roomId).data.ownerUid == request.auth.uid;
    }

    function freeTierLocked() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.freeTierLocked == true;
    }

    function validRetention(data) {
      return data.retentionDays == 3 || data.retentionDays == 7 || data.retentionDays == 10;
    }

    function roomIsLive(roomId) {
      return roomExists(roomId)
        && room(roomId).data.status == "live"
        && validRetention(room(roomId).data)
        && request.time < room(roomId).data.createdAt
          + duration.value(room(roomId).data.retentionDays, "d");
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid);
      allow update: if owner(uid)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.subscriptionExpiresAt == resource.data.subscriptionExpiresAt;
      allow delete: if false;
    }

    match /payments/{id} {
      allow read, write: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && validRetention(request.resource.data)
        && (
          (request.resource.data.plan == "free"
            && request.resource.data.retentionDays == 3
            && request.resource.data.slug == ""
            && !freeTierLocked())
          ||
          (request.resource.data.plan == "starter"
            && request.resource.data.retentionDays == 7
            && request.resource.data.slug == "")
          ||
          (request.resource.data.plan == "pro"
            && request.resource.data.retentionDays == 10)
        );

      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      match /blocked/{participantId} {
        allow read: if true;
        allow write: if isRoomOwner(roomId);
      }

      match /viewers/{viewerId} {
        allow read, write: if false;
      }
    }

    match /messages/{messageId} {
      allow read: if roomIsLive(resource.data.roomId);

      allow create: if roomIsLive(request.resource.data.roomId)
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000
        && request.resource.data.participantId is string
        && request.resource.data.participantId.size() > 0
        && request.resource.data.participantId.size() <= 24
        && request.resource.data.edited == false;

      allow update: if roomIsLive(resource.data.roomId)
        && resource.data.participantId == request.resource.data.participantId
        && request.resource.data.roomId == resource.data.roomId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.quotedMessageId == resource.data.quotedMessageId
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000;

      allow delete: if true;
    }

    match /reports/{reportId} {
      allow create: if request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200;
      allow read, update, delete: if false;
    }

    match /typing/{roomId}/users/{participantId} {
      allow read: if roomIsLive(roomId);
      allow write: if roomIsLive(roomId)
        && request.resource.data.participantId == participantId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
