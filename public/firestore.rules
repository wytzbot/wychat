rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // HELPER FUNCTIONS
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function roomExists(roomId) {
      return exists(
        /databases/$(database)/documents/rooms/$(roomId)
      );
    }

    function getRoom(roomId) {
      return get(
        /databases/$(database)/documents/rooms/$(roomId)
      );
    }

    function isRoomOwner(roomId) {
      return signedIn()
        && roomExists(roomId)
        && getRoom(roomId).data.ownerUid == request.auth.uid;
    }

    function validRetention(days) {
      return days == 3
        || days == 7
        || days == 10;
    }

    function roomIsLive(roomId) {
      return roomExists(roomId)
        && getRoom(roomId).data.status == "live";
    }


    // =========================
    // USERS
    // =========================

    match /users/{uid} {

      allow read: if isOwner(uid);

      allow create: if isOwner(uid);

      allow update: if isOwner(uid);

      allow delete: if false;
    }


    // =========================
    // ROOMS
    // =========================

    match /rooms/{roomId} {

      // Anyone can look up a room.
      // This is required because anonymous users
      // need to enter shared rooms.
      allow read: if true;


      // =========================
      // CREATE ROOM
      // =========================

      allow create: if signedIn()

        // The authenticated user must own the room.
        && request.resource.data.ownerUid == request.auth.uid

        // Required room state.
        && request.resource.data.status == "live"

        // Question must be valid.
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 500

        // Valid expiration period.
        && validRetention(
          request.resource.data.retentionDays
        )

        // Free plan.
        && (
          (
            request.resource.data.plan == "free"
            && request.resource.data.retentionDays == 3
            && request.resource.data.slug == ""
          )

          ||

          // Starter plan.
          (
            request.resource.data.plan == "starter"
            && request.resource.data.retentionDays == 7
            && request.resource.data.slug == ""
          )

          ||

          // Pro plan.
          (
            request.resource.data.plan == "pro"
            && request.resource.data.retentionDays == 10
          )
        );


      // =========================
      // UPDATE / DELETE ROOM
      // =========================

      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;


      // =========================
      // BLOCKED PARTICIPANTS
      // =========================

      match /blocked/{participantId} {

        allow read: if true;

        allow create, update, delete: if isRoomOwner(roomId);
      }


      // =========================
      // VIEWERS
      // =========================

      match /viewers/{viewerId} {

        allow read: if true;

        allow create, update, delete: if false;
      }
    }


    // =========================
    // MESSAGES
    // =========================

    match /messages/{messageId} {

      // Anyone can read messages belonging to a live room.
      allow read: if roomIsLive(resource.data.roomId);


      // Anonymous users can send messages.
      allow create: if roomIsLive(
          request.resource.data.roomId
        )

        && request.resource.data.content is string

        && request.resource.data.content.size() > 0

        && request.resource.data.content.size() <= 2000

        && request.resource.data.participantId is string

        && request.resource.data.participantId.size() > 0

        && request.resource.data.participantId.size() <= 100;


      // Message editing.
      allow update: if roomIsLive(resource.data.roomId)

        && resource.data.participantId ==
           request.resource.data.participantId

        && resource.data.roomId ==
           request.resource.data.roomId

        && request.resource.data.content is string

        && request.resource.data.content.size() > 0

        && request.resource.data.content.size() <= 2000;


      // Allow message deletion.
      allow delete: if roomIsLive(resource.data.roomId);
    }


    // =========================
    // TYPING INDICATORS
    // =========================

    match /typing/{roomId}/users/{participantId} {

      allow read: if roomIsLive(roomId);


      allow create, update: if roomIsLive(roomId)

        && request.resource.data.participantId ==
           participantId;


      // IMPORTANT:
      // Don't use request.resource here.
      // request.resource doesn't exist during DELETE.
      allow delete: if roomIsLive(roomId);
    }


    // =========================
    // REPORTS
    // =========================

    match /reports/{reportId} {

      allow create: if request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500;

      allow read, update, delete: if false;
    }


    // =========================
    // PAYMENTS
    // =========================

    match /payments/{paymentId} {

      // Payment records should only be written
      // by your server/webhook.
      allow read, write: if false;
    }


    // =========================
    // DEFAULT DENY
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
