rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function room(roomId) {
      return get(/databases/$(database)/documents/rooms/$(roomId));
    }

    function roomExists(roomId) {
      return exists(/databases/$(database)/documents/rooms/$(roomId));
    }

    function isRoomOwner(roomId) {
      return signedIn()
        && roomExists(roomId)
        && room(roomId).data.ownerUid == request.auth.uid;
    }

    function roomIsLive(roomId) {
      return roomExists(roomId)
        && room(roomId).data.status == "live"
        && request.time < room(roomId).data.createdAt + duration.value(3, "d");
    }


    // =========================
    // USERS
    // =========================

    match /users/{uid} {

      allow read: if owner(uid);

      allow create: if owner(uid);

      allow update: if owner(uid)
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.subscriptionExpiresAt == resource.data.subscriptionExpiresAt;

      allow delete: if false;
    }


    // =========================
    // PAYMENTS
    // =========================

    match /payments/{id} {
      allow read, write: if false;
    }


    // =========================
    // ROOMS
    // =========================

    match /rooms/{roomId} {

      // Anyone with the room link can view the room.
      // The 3-day expiry is enforced below.
      allow read: if true;

      // Authenticated owner can create a room.
      // We intentionally DO NOT require retentionDays.
      // Every room is automatically limited to 3 days by createdAt.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;

      // Owner can update/delete only while room is still within
      // its 3-day lifetime.
      allow update, delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == "live"
        && request.time < resource.data.createdAt + duration.value(3, "d");


      // =========================
      // BLOCKED PARTICIPANTS
      // =========================

      match /blocked/{participantId} {

        allow read: if true;

        allow write: if isRoomOwner(roomId);
      }
    }


    // =========================
    // MESSAGES
    // =========================

    match /messages/{messageId} {

      // Nobody can read messages after 3 days.
      allow read: if roomIsLive(resource.data.roomId);


      // Nobody can send messages after 3 days.
      allow create: if roomIsLive(request.resource.data.roomId)

        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 2000

        && request.resource.data.participantId is string
        && request.resource.data.participantId.size() > 0
        && request.resource.data.participantId.size() <= 24

        && request.resource.data.edited == false;


      // Editing is only allowed while the room is still alive.
      allow update: if roomIsLive(resource.data.roomId)

        && resource.data.participantId == request.resource.data.participantId

        && request.resource.data.roomId == resource.data.roomId

        && request.resource.data.createdAt == resource.data.createdAt

        && request.resource.data.quotedMessageId == resource.data.quotedMessageId

        && request.resource.data.content is string

        && request.resource.data.content.size() > 0

        && request.resource.data.content.size() <= 2000;


      allow delete: if true;
    }


    // =========================
    // REPORTS
    // =========================

    match /reports/{reportId} {

      allow create: if request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 200;

      allow read, update, delete: if false;
    }


    // =========================
    // TYPING INDICATOR
    // =========================

    match /typing/{roomId}/users/{participantId} {

      allow read: if roomIsLive(roomId);

      allow write: if roomIsLive(roomId)
        && request.resource.data.participantId == participantId;
    }


    // =========================
    // EVERYTHING ELSE
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
